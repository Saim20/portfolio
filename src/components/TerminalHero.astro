---
import { site, contact, certifications, skillGroups } from '../data/site';
import { projects } from '../data/projects';
import { quests } from '../data/quests';

/**
 * The full replay text is server-rendered, so the content is real HTML for
 * crawlers and for anyone without JavaScript. The inline script replays it as
 * typing; once that finishes (or is skipped) it flags `data-ready` and
 * src/scripts/terminal.ts turns the last line into a working prompt.
 * Lines wrap inside the body, so a long line never opens a horizontal
 * scrollbar. The panel gives the body a flex height; this component does not.
 */
const lines: Array<{ cmd?: string; out?: string; accent?: boolean }> = [
  { cmd: 'whoami' },
  { out: 'SM Saimul Islam - product lead & full-stack engineer' },
  { cmd: 'ls ~/shipped' },
  { out: projects.map((p) => p.slug).join('  ') },
  { cmd: 'cat stack.txt' },
  { out: 'next.js  flutter  typescript  postgres' },
  { cmd: './contact --now' },
  { out: contact.email, accent: true },
];

const ielts = certifications.find((cert) => cert.highlight);

const payload = {
  name: site.name,
  email: contact.email,
  mail: `mailto:${contact.email}?subject=${encodeURIComponent('Project enquiry')}`,
  linkedin: contact.linkedin,
  role: site.role,
  location: `${site.location.city}, ${site.location.country} (UTC+6)`,
  stack: skillGroups.flatMap((group) => [...group.items]),
  ielts: ielts ? `${ielts.name}${ielts.detail ? ` - ${ielts.detail.toLowerCase()}` : ''}` : 'n/a',
  projects: projects.map((p) => ({
    slug: p.slug,
    name: p.name,
    tagline: p.tagline,
    href: p.links[0]?.href ?? null,
  })),
  quests: quests.map((q) => ({ id: q.id, title: q.title, hint: q.hint })),
};
---

<div class="relative" data-terminal>
  <div class="terminal-window overflow-hidden rounded-xl border border-line bg-surface shadow-2xl shadow-black/20">
  <div class="flex min-w-0 items-center gap-2 border-b border-line bg-surface-2 px-3 py-2 sm:gap-3 sm:px-4 sm:py-2.5">
    <span class="flex shrink-0 gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <span class="min-w-0 truncate font-mono text-[0.65rem] text-muted sm:text-xs">saim@dhaka - zsh</span>
    <button
      type="button"
      data-terminal-skip
      hidden
      class="ml-auto shrink-0 rounded font-mono text-xs text-muted transition-colors hover:text-accent"
    >
      skip
    </button>
  </div>

  <div
    class="terminal-body overflow-x-hidden overflow-y-auto px-3 py-3 font-mono text-[0.72rem] leading-snug sm:px-4 sm:py-3.5 sm:text-[0.8rem]"
  >
    <code class="terminal-code">
      {
        lines.map((line) => (
          <span class="terminal-line" data-line>
            {line.cmd ? (
              <>
                <span class="select-none text-accent" data-prompt aria-hidden="true">$ </span>
                <span class="text-fg" data-text>
                  {line.cmd}
                </span>
              </>
            ) : (
              <span class:list={[line.accent ? 'text-warm' : 'text-fg-soft']} data-text data-instant>
                {line.out}
              </span>
            )}
          </span>
        ))
      }
      <span class="terminal-line terminal-prompt" data-terminal-prompt hidden>
        <span class="select-none text-accent" aria-hidden="true">$ </span>
        <label for="terminal-input" class="sr-only">Type a command, or help</label>
        <input
          id="terminal-input"
          data-terminal-input
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
          placeholder="type a command"
          aria-autocomplete="list"
          aria-controls="terminal-suggestions"
          class="terminal-input"
        />
      </span>
    </code>
  </div>

  <div
    data-terminal-chips
    hidden
    class="flex flex-wrap gap-1.5 border-t border-line/70 px-3 py-2 sm:px-4"
    aria-label="All commands"
  >
  </div>

  <script is:inline type="application/json" data-terminal-data set:html={JSON.stringify(payload)} />
  </div>
  <div
    id="terminal-suggestions"
    data-terminal-suggest
    hidden
    role="listbox"
    aria-label="Command suggestions"
    class="terminal-suggest"
  ></div>
</div>

<!-- Global on purpose: terminal.ts creates .terminal-line nodes at runtime, which
     would miss Astro's scoped-style attribute. Everything is namespaced under [data-terminal]. -->
<style is:global>
  [data-terminal] .terminal-code {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  [data-terminal] .terminal-line {
    display: block;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.35;
  }

  [data-terminal] .terminal-body {
    position: relative;
    min-height: 0;
    scrollbar-width: thin;
  }

  [data-terminal] .terminal-suggest {
    position: absolute;
    z-index: 40;
    top: calc(100% + 0.4rem);
    right: 0;
    left: 0;
    max-height: 14rem;
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    background: var(--color-surface);
    box-shadow: 0 16px 36px -18px rgb(0 0 0 / 0.45);
    scrollbar-width: thin;
  }

  [data-terminal] .terminal-suggest button {
    display: block;
    width: 100%;
    padding: 0.3rem 0.6rem;
    text-align: left;
    font: inherit;
    color: var(--color-fg-soft);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  [data-terminal] .terminal-suggest button[aria-selected='true'] {
    background: color-mix(in oklab, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
  }

  [data-terminal] .terminal-prompt {
    display: flex;
    align-items: center;
  }

  /* Replay prompt glyphs stay hidden until that line's text is actually drawing. */
  [data-terminal][data-playing] .terminal-line:not([data-shown]) [data-prompt] {
    visibility: hidden;
  }

  [data-terminal] .terminal-line[data-typing]::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1em;
    translate: 0 0.1em;
    background-color: var(--color-accent);
    animation: terminal-caret 1s step-end infinite;
  }

  @keyframes terminal-caret {
    50% {
      opacity: 0;
    }
  }
</style>

<style>
  .terminal-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
    color: var(--color-fg);
    font: inherit;
    line-height: inherit;
    caret-color: var(--color-accent);
  }

  .terminal-input::placeholder {
    color: var(--color-muted);
  }

  [data-token='ok'] .terminal-input {
    color: var(--color-accent);
  }

  [data-token='bad'] .terminal-input {
    color: var(--color-error);
  }
</style>

<script is:inline>
  if (!window.__terminal) {
    window.__terminal = true;

    const run = () => {
      const terminal = document.querySelector('[data-terminal]');
      if (!terminal || terminal.dataset.played) return;
      terminal.dataset.played = 'true';

      const ready = () => {
        terminal.dataset.ready = 'true';
      };

      let seen = false;
      try {
        seen = sessionStorage.getItem('saim.terminal.seen') === '1';
      } catch {
        /* private mode: play it */
      }
      try {
        sessionStorage.setItem('saim.terminal.seen', '1');
      } catch {
        /* private mode */
      }
      if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return ready();

      const skip = terminal.querySelector('[data-terminal-skip]');
      const lines = [...terminal.querySelectorAll('[data-line]')];
      const parts = lines.map((line) => {
        const target = line.querySelector('[data-text]');
        return { line, target, text: target.textContent, instant: 'instant' in target.dataset };
      });

      let cancelled = false;
      const finish = () => {
        cancelled = true;
        delete terminal.dataset.playing;
        for (const part of parts) {
          part.target.textContent = part.text;
          delete part.line.dataset.typing;
          part.line.dataset.shown = 'true';
        }
        if (skip) skip.hidden = true;
        ready();
      };

      // Hide every replay "$" before clearing the lines, so the glyphs never
      // sit on screen ahead of the text they belong to.
      terminal.dataset.playing = 'true';
      for (const part of parts) part.target.textContent = '';
      if (skip) {
        skip.hidden = false;
        skip.addEventListener('click', finish, { once: true });
      }

      const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      (async () => {
        await wait(80);
        for (const part of parts) {
          if (cancelled) return;
          part.line.dataset.shown = 'true';
          part.line.dataset.typing = 'true';

          if (part.instant) {
            part.target.textContent = part.text;
            await wait(90);
          } else {
            for (const char of part.text) {
              if (cancelled) return;
              part.target.textContent += char;
              await wait(10 + Math.random() * 6);
            }
            await wait(70);
          }

          if (cancelled) return;
          delete part.line.dataset.typing;
        }
        if (cancelled) return;
        delete terminal.dataset.playing;
        if (skip) skip.hidden = true;
        ready();
      })();
    };

    document.addEventListener('terminal:open', run);
  }
</script>

<script>
  import '../scripts/terminal';
</script>
