---
---

<button
  type="button"
  data-theme-toggle
  class="ml-1 grid size-9 place-items-center rounded-md border border-line text-fg-soft transition-colors hover:border-accent hover:text-accent"
  aria-label="Switch between light and dark theme"
>
  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <g data-icon="dark">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linecap="round" />
    </g>
    <g data-icon="light">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" stroke-linecap="round" />
    </g>
  </svg>
</button>

<style>
  :root[data-theme='dark'] [data-icon='light'],
  :root[data-theme='light'] [data-icon='dark'] {
    display: none;
  }
</style>

<script is:inline>
  if (!window.__themeToggle) {
    window.__themeToggle = true;
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-theme-toggle]');
      if (!button) return;
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode */
      }
    });
  }
</script>
