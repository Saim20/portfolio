---
import { personas } from '../data/personas';

/**
 * "Who are you?" segmented control. The choice is stored as `html[data-persona]`
 * (set before paint by ThemeScript) and in localStorage. Hero copy is swapped by
 * the inline script below; section order and proof-chip emphasis are pure CSS.
 */
const options = personas.filter((persona) => persona.id !== 'generic');
const payload = Object.fromEntries(
  personas.map((persona) => [
    persona.id,
    {
      headline: persona.headline,
      intro: persona.intro,
      cta: persona.cta,
      secondary: persona.secondary,
    },
  ]),
);
---

<div class="persona-switch" data-persona-switch>
  <p id="persona-switch-label" class="text-base font-semibold tracking-tight text-fg sm:text-xl">
    What are you here for?
  </p>
  <div
    role="group"
    aria-labelledby="persona-switch-label"
    class="mt-3 grid grid-cols-3 gap-2 sm:mt-4 sm:gap-3"
  >
    {
      options.map((persona) => (
        <button
          type="button"
          data-persona-option={persona.id}
          aria-pressed={persona.id === 'hiring' ? 'true' : 'false'}
          class="min-h-14 rounded-xl border-2 border-line bg-surface px-2 py-3 text-center text-sm font-semibold leading-tight text-fg shadow-sm transition-colors hover:border-accent/70 sm:min-h-16 sm:px-4 sm:py-4 sm:text-lg"
        >
          {persona.label}
        </button>
      ))
    }
  </div>
</div>

<script is:inline type="application/json" data-persona-data set:html={JSON.stringify(payload)} />

<style>
  /* Active segment, driven by the html attribute so it is right on first paint. */
  :global(html[data-persona='hiring']) [data-persona-option='hiring'],
  :global(html[data-persona='founder']) [data-persona-option='founder'],
  :global(html[data-persona='browsing']) [data-persona-option='browsing'] {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-accent) 28%, transparent);
  }
</style>

<script is:inline>
  if (!window.__persona) {
    window.__persona = true;

    const VALID = ['hiring', 'founder', 'browsing'];

    const read = () => {
      const raw = document.querySelector('[data-persona-data]');
      if (!raw) return null;
      try {
        return JSON.parse(raw.textContent || '{}');
      } catch {
        return null;
      }
    };

    const setText = (field, text) => {
      for (const el of document.querySelectorAll(`[data-persona-field="${field}"]`)) {
        el.textContent = text;
      }
    };

    const setLink = (field, link) => {
      for (const el of document.querySelectorAll(`[data-persona-field="${field}"]`)) {
        el.textContent = link.label;
        el.setAttribute('href', link.href);
      }
    };

    /** Swap hero copy to the active persona. Safe to call any number of times. */
    const apply = () => {
      const data = read();
      if (!data) return;
      const current = document.documentElement.dataset.persona;
      const id = VALID.includes(current) ? current : 'hiring';
      if (current !== id) document.documentElement.dataset.persona = id;
      const persona = data[id] || data.hiring;
      if (!persona) return;

      const match = persona.headline.match(/^(.*?)\*(.+?)\*(.*)$/);
      const parts = match
        ? { before: match[1], accent: match[2], after: match[3] }
        : { before: persona.headline, accent: '', after: '' };
      setText('headline-before', parts.before);
      setText('headline-accent', parts.accent);
      setText('headline-after', parts.after);
      setText('intro', persona.intro);
      setLink('cta', persona.cta);
      setLink('secondary', persona.secondary);

      for (const button of document.querySelectorAll('[data-persona-option]')) {
        button.setAttribute('aria-pressed', String(button.dataset.personaOption === id));
      }
    };

    window.__applyPersona = apply;

    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-persona-option]');
      if (!button) return;
      const next = button.dataset.personaOption;
      if (!VALID.includes(next)) return;
      document.documentElement.dataset.persona = next;
      try {
        localStorage.setItem('persona', next);
      } catch {
        /* private mode */
      }
      apply();
      document.dispatchEvent(new CustomEvent('quest:request', { detail: { id: 'persona' } }));
    });

    document.addEventListener('astro:page-load', apply);
  }
</script>
