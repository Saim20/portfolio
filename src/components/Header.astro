---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-bg/80 pt-[env(safe-area-inset-top,0px)] backdrop-blur-md"
>
  <div class="container-page flex h-14 items-center justify-between gap-2 sm:h-16 sm:gap-4">
    <a
      href="/"
      class="group font-medium tracking-tight text-[0.95rem] transition-colors hover:text-accent sm:text-base"
      data-logo
      aria-label={`${site.name} - home`}
    >
      {site.shortName}
    </a>

    <nav aria-label="Primary" class="flex items-center gap-0.5 sm:gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="rounded-md px-2 py-2 text-sm text-fg-soft transition-colors hover:text-fg sm:px-3 aria-[current=page]:text-accent"
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
