---
import type { Project } from '../data/projects';
import ProjectPoster from './ProjectPoster.astro';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const caseStudy = `/work/${project.slug}`;
---

<article class="project-card group relative flex flex-col gap-5" data-category={project.category}>
  <a href={caseStudy} class="block rounded-lg" tabindex="-1" aria-hidden="true">
    <ProjectPoster project={project} eager={eager} />
  </a>

  <div class="flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">
      <span>{project.category}</span>
      <span aria-hidden="true">/</span>
      <span>{project.role}</span>
    </div>

    <h3 class="text-2xl font-semibold tracking-tight">
      <a
        href={caseStudy}
        class="transition-colors group-hover:text-accent focus-visible:text-accent"
      >
        {project.name}
        <!-- Stretched hit area: the whole card is clickable, one link in the a11y tree. -->
        <span class="absolute inset-0" aria-hidden="true"></span>
      </a>
    </h3>

    <p class="text-sm text-muted">{project.tagline}</p>

    <ul class="flex flex-wrap gap-1.5" aria-label={`${project.name} stack`}>
      {
        project.stack.slice(0, 4).map((tech) => (
          <li class="rounded-full border border-line bg-surface px-2.5 py-0.5 font-mono text-[0.68rem] text-muted">
            {tech}
          </li>
        ))
      }
    </ul>

    <div class="relative z-10 mt-1 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <span class="text-accent">Read the case study &rarr;</span>
      {
        project.links
          .filter((link) => link.primary)
          .map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg hover:decoration-accent"
            >
              {link.label}
            </a>
          ))
      }
    </div>
  </div>
</article>

<script>
  /**
   * Pointer-tracked tilt for the poster frame. One delegated listener for every
   * card on the page; skipped entirely on touch devices and under reduced motion.
   */
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (fine.matches && motion.matches && !(window as Window & { __tilt?: boolean }).__tilt) {
    (window as Window & { __tilt?: boolean }).__tilt = true;

    document.addEventListener('pointermove', (event) => {
      const card = (event.target as Element | null)?.closest<HTMLElement>('.project-card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      card.style.setProperty('--tilt-x', `${(-y * 6).toFixed(2)}deg`);
      card.style.setProperty('--tilt-y', `${(x * 8).toFixed(2)}deg`);
      card.style.setProperty('--glare-x', `${((x + 0.5) * 100).toFixed(1)}%`);
      card.style.setProperty('--glare-y', `${((y + 0.5) * 100).toFixed(1)}%`);
    });

    document.addEventListener('pointerout', (event) => {
      const card = (event.target as Element | null)?.closest<HTMLElement>('.project-card');
      if (!card || card.contains(event.relatedTarget as Node | null)) return;
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    });
  }
</script>
