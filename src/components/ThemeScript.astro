---
/**
 * Runs synchronously in <head> so data-theme is set before first paint.
 * Light is the default. A stored choice wins; the OS preference does not.
 */
---

<script is:inline>
  (() => {
    const apply = () => {
      let theme = 'light';
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') theme = stored;
      } catch {
        /* private mode: stay on the light default */
      }
      document.documentElement.dataset.theme = theme;

      // Explorer mode persona: hiring unless the visitor already chose otherwise,
      // so CSS-driven ordering is right on first paint.
      let persona = 'hiring';
      try {
        const stored = localStorage.getItem('persona');
        if (stored === 'hiring' || stored === 'founder' || stored === 'browsing') persona = stored;
      } catch {
        /* private mode */
      }
      document.documentElement.dataset.persona = persona;
    };

    apply();
    // View transitions swap the <html> attributes, so re-apply after each navigation.
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
