---
import { now } from '../data/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['rounded-xl border border-line bg-surface/60 p-5 sm:p-6', className]}>
  <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">
    <span class="relative grid size-2 place-items-center" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-accent"></span>
      <span class="absolute inset-0 animate-ping rounded-full bg-accent opacity-60"></span>
    </span>
    Now
  </p>
  <dl class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      now.map((item) => (
        <div class="flex gap-3 text-sm">
          <dt class="w-16 shrink-0 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-muted pt-0.5">
            {item.label}
          </dt>
          <dd>
            <a
              href={item.href}
              class="text-fg-soft underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >
              {item.text}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</div>
