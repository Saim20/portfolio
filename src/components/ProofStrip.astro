---
import { personas } from '../data/personas';
import { certifications, education } from '../data/site';
import { projects } from '../data/projects';

/**
 * The five facts a visitor needs before they scroll. Personas promote some chips
 * to the front with CSS `order`, so the markup is identical for everyone.
 */
const live = projects.filter((project) => project.live).length;
const highlighted = certifications.find((cert) => cert.highlight);

const chips = [
  { id: 'years', value: '5+', label: 'years shipping production software' },
  { id: 'live', value: String(live), label: 'products live for real users' },
  { id: 'rating', value: '4.3 / 5', label: 'StuDays on the App Store' },
  ...(highlighted ? [{ id: 'ielts', value: highlighted.name.replace('IELTS ', ''), label: 'IELTS' }] : []),
  { id: 'iba', value: 'IBA', label: `${education[0].credential.split(',')[0]}, University of Dhaka` },
];

// e.g. html[data-persona="hiring"] [data-proof="ielts"] { order: -3 }
const orderCss = personas
  .flatMap((persona) =>
    persona.lead.map(
      (id, index) =>
        `html[data-persona="${persona.id}"] [data-proof="${id}"]{order:${index - persona.lead.length}}`,
    ),
  )
  .join('');
---

<dl class="proof-strip" aria-label="Key facts">
  {
    chips.map((chip) => (
      <div data-proof={chip.id} class="proof-chip">
        <dt class="sr-only">{chip.label}</dt>
        <dd>
          <span class="block text-2xl font-semibold tracking-tight text-accent sm:text-3xl">
            {chip.value}
          </span>
          <span class="mt-1 block text-xs text-muted sm:text-sm">{chip.label}</span>
        </dd>
      </div>
    ))
  }
</dl>

<style is:inline set:html={orderCss}></style>

<style>
  .proof-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  @media (width >= 40rem) {
    .proof-strip {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .proof-chip {
    transition: transform 0.4s var(--ease-out-soft);
  }

  /* Promoted chips get a small lift so the reorder reads as intentional. */
  :global(html[data-persona='hiring']) [data-proof='ielts'],
  :global(html[data-persona='hiring']) [data-proof='years'],
  :global(html[data-persona='founder']) [data-proof='live'],
  :global(html[data-persona='founder']) [data-proof='rating'],
  :global(html[data-persona='browsing']) [data-proof='live'] {
    transform: translateY(-0.15rem);
  }
</style>
