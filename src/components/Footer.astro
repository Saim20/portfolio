---
import { site, contact, socials } from '../data/site';
import LocalTime from './LocalTime.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line/70 bg-surface/40">
  <div class="container-page flex flex-col gap-8 py-12 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-sm">
      <p class="font-medium">{site.name}</p>
      <p class="mt-2 text-sm text-muted">{site.role}, based in {site.location.city}.</p>
      <LocalTime class="mt-4" />
    </div>

    <div class="flex flex-col gap-3 text-sm">
      <a class="break-all text-fg-soft transition-colors hover:text-accent" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>
      {
        socials.map((social) =>
          social.href.startsWith('mailto:') ? null : (
            <a
              class="text-fg-soft transition-colors hover:text-accent"
              href={social.href}
              rel="me noopener"
              target="_blank"
            >
              {social.label}
            </a>
          ),
        )
      }
      <a class="text-fg-soft transition-colors hover:text-accent" href="/llms.txt">llms.txt</a>
    </div>
  </div>

  <div class="container-page pb-10 text-xs text-muted">
    <p>&copy; {year} {site.name}. Built with Astro - no trackers, no cookie banner.</p>
  </div>
</footer>
