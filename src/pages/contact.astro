---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalTime from '../components/LocalTime.astro';
import Icon from '../components/Icon.astro';
import { site, contact } from '../data/site';
import { buildGraph, breadcrumbNode, canonical } from '../lib/seo';

const graph = buildGraph([
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]),
  {
    '@type': 'ContactPage',
    '@id': `${canonical(Astro.url.pathname)}#contactpage`,
    url: canonical(Astro.url.pathname),
    mainEntity: { '@id': `${site.url}/#person` },
  },
]);

const channels = [
  {
    label: 'Email',
    icon: 'mail',
    value: contact.email,
    href: `mailto:${contact.email}`,
    note: 'Best for project enquiries. I reply within a day.',
  },
  {
    label: 'LinkedIn',
    icon: 'linkedin',
    value: contact.linkedinHandle,
    href: contact.linkedin,
    note: 'For the full work history and a connection request.',
  },
  {
    label: 'Phone / WhatsApp',
    icon: 'phone',
    value: contact.phoneDisplay,
    href: `tel:${contact.phone}`,
    note: 'If it is urgent, or you would rather just talk.',
  },
];

const brief = [
  'What you are building, in a sentence or two',
  'Whether it is web, mobile, or both',
  'Your rough timeline and budget range',
  'Anything already built that I would be inheriting',
];
---

<BaseLayout
  title={`Contact ${site.name} - start a project`}
  description={`Get in touch with SM Saimul Islam, product lead and full-stack engineer in Dhaka. Email ${contact.email} or connect on LinkedIn to discuss web platforms, SaaS, and mobile apps.`}
  graph={graph}
>
  <header class="container-page pt-14 pb-10 sm:pt-20">
    <p class="kicker text-accent">Contact</p>
    <h1 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Let's talk about what you need built
    </h1>
    <p class="mt-4 max-w-xl text-fg-soft">
      No forms, no funnel. Pick whichever of these you actually use and I will get back to you.
    </p>
    <LocalTime class="mt-6" />
  </header>

  <section aria-label="Contact channels" class="container-page pb-8">
    <ul class="divide-y divide-line border-y border-line">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              data-quest="ready-to-talk"
              class="group flex flex-col gap-1 py-6 sm:flex-row sm:items-center sm:gap-8"
              {...(channel.href.startsWith('http')
                ? { target: '_blank', rel: 'me noopener' }
                : {})}
            >
              <span class="flex items-center gap-2.5 sm:w-52">
                <Icon
                  name={channel.icon}
                  class="size-4 shrink-0 text-accent transition-transform duration-300 group-hover:-translate-y-0.5"
                />
                <span class="kicker text-muted">{channel.label}</span>
              </span>
              <span class="flex-1 min-w-0">
                <span class="block font-medium break-words transition-colors group-hover:text-accent">
                  {channel.value}
                </span>
                <span class="mt-1 block text-sm text-muted">{channel.note}</span>
              </span>
              <span
                class="hidden text-accent transition-transform group-hover:translate-x-1 sm:block"
                aria-hidden="true">&rarr;</span
              >
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="brief-heading" class="container-page py-16">
    <div class="max-w-xl">
      <h2 id="brief-heading" class="text-xl font-semibold tracking-tight">
        To save us a round trip
      </h2>
      <p class="mt-3 text-sm text-fg-soft">
        Include whatever you have of the following and I can usually tell you in one reply whether
        I am a fit and what it would take.
      </p>
      <ul class="mt-6 space-y-3">
        {
          brief.map((item) => (
            <li class="flex gap-3 text-sm text-fg-soft">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={`mailto:${contact.email}?subject=Project%20enquiry`}
        data-quest="ready-to-talk"
        class="mt-8 inline-block rounded-lg bg-accent px-5 py-3 font-medium text-accent-fg transition-transform hover:-translate-y-0.5"
      >
        Email me the brief
      </a>
    </div>
  </section>
</BaseLayout>
