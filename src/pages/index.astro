---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import TerminalHero from '../components/TerminalHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LocalTime from '../components/LocalTime.astro';
import PersonaSwitch from '../components/PersonaSwitch.astro';
import ProofStrip from '../components/ProofStrip.astro';
import NowCard from '../components/NowCard.astro';
import { site, services, skillGroups } from '../data/site';
import { featuredProjects, projects } from '../data/projects';
import { getPersona, splitHeadline } from '../data/personas';
import { buildGraph, itemListNode, projectNode } from '../lib/seo';

const graph = buildGraph([itemListNode(), ...projects.map(projectNode)]);

// Server-rendered copy is the hiring persona, the default. The switch swaps it.
const persona = getPersona('hiring');
const headline = splitHeadline(persona.headline);
---

<BaseLayout
  title={`${site.name} - ${site.role} in Dhaka`}
  description={site.description}
  graph={graph}
>
  <section class="container-page pt-6 pb-8 sm:pt-10">
    <PersonaSwitch />

    <div class="mt-8 grid items-center gap-8 sm:mt-10 sm:gap-10 lg:grid-cols-[1.05fr_1fr] lg:mt-12 lg:gap-16">
      <div>
        <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-3">
          {
            site.availability && (
              <p class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent-soft/30 px-3 py-1 text-xs text-accent">
                <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                {site.availability}
              </p>
            )
          }
          <LocalTime />
        </div>

        <h1 class="mt-5 text-[1.65rem] font-semibold leading-tight tracking-tight text-balance min-[480px]:text-4xl sm:mt-6 sm:text-5xl lg:text-[3.4rem] lg:leading-[1.05]">
          <span data-persona-field="headline-before">{headline.before}</span><span
            class="text-accent"
            data-persona-field="headline-accent">{headline.accent}</span
          ><span data-persona-field="headline-after">{headline.after}</span>
        </h1>

        <p
          class="mt-4 max-w-xl text-base text-fg-soft text-pretty sm:mt-6 sm:text-lg"
          data-persona-field="intro"
        >
          {persona.intro}
        </p>

        <div class="mt-6 flex flex-col gap-3 min-[400px]:flex-row min-[400px]:flex-wrap min-[400px]:items-center sm:mt-8">
          <a
            href={persona.cta.href}
            data-persona-field="cta"
            class="rounded-lg bg-accent px-5 py-3 text-center font-medium text-accent-fg transition-transform hover:-translate-y-0.5"
          >
            {persona.cta.label}
          </a>
          <a
            href={persona.secondary.href}
            data-persona-field="secondary"
            class="rounded-lg border border-line px-5 py-3 text-center font-medium text-fg-soft transition-colors hover:border-accent hover:text-accent"
          >
            {persona.secondary.label}
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:pl-4">
        <TerminalHero />
      </div>
    </div>

    <!-- Returning visitors get their persona copy before first paint. -->
    <script is:inline data-astro-rerun>
      window.__applyPersona && window.__applyPersona();
    </script>

    <div class="mt-12 border-t border-line pt-8 sm:mt-14 sm:pt-10">
      <ProofStrip />
    </div>
  </section>

  <!-- Sections below are reordered per persona with CSS `order` (see global.css). -->
  <div class="flex flex-col" data-home-sections>
    <Section
      id="work"
      kicker="Selected work"
      title="Products in production, not prototypes"
      lead="Three of these are live right now. Each case study covers the problem, what I built, and the tradeoffs behind it."
      data-quest-view="first-steps"
    >
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
        {
          featuredProjects.map((project, index) => (
            <ProjectCard project={project} eager={index === 0} />
          ))
        }
      </div>

      <p class="mt-12">
        <a
          href="/work"
          class="text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          All work, including earlier builds &rarr;
        </a>
      </p>
    </Section>

    <Section
      id="now"
      kicker="Right now"
      title="Three things at once, on purpose"
      lead="A government platform, a classroom, and a business degree - the overlap is the point. Each one makes me better at the other two."
    >
      <NowCard />
    </Section>

    <Section
      id="services"
      kicker="How I help"
      title="One person for the whole technical scope"
      lead="A business degree from IBA and five years of shipping code means you get strategy and execution from the same conversation."
    >
      <div class="grid gap-6 sm:grid-cols-2">
        {
          services.map((service) => (
            <div class="reveal rounded-xl border border-line bg-surface/60 p-6 transition-colors hover:border-accent/50">
              <h3 class="font-medium">{service.title}</h3>
              <p class="mt-2 text-sm text-fg-soft">{service.body}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="stack" kicker="Toolkit" title="What I reach for">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          skillGroups.map((group) => (
            <div class="reveal">
              <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-muted">{group.label}</h3>
              <ul class="mt-4 space-y-2 text-sm text-fg-soft">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <section class="container-page py-16" style="order: 100">
      <div class="reveal rounded-2xl border border-line bg-surface/60 p-6 text-center sm:p-12">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl text-balance">
          Have something that needs building?
        </h2>
        <p class="mx-auto mt-4 max-w-md text-fg-soft">
          Tell me what you are trying to ship. I will tell you honestly whether I am the right person
          for it.
        </p>
        <a
          href="/contact"
          data-quest="ready-to-talk"
          class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-medium text-accent-fg transition-transform hover:-translate-y-0.5"
        >
          Get in touch
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
