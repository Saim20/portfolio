---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, contact, milestones } from '../data/site';
import { projects } from '../data/projects';
import { QUEST_TOTAL } from '../data/quests';
import { buildGraph, breadcrumbNode } from '../lib/seo';

/**
 * The explorer-mode reward. Reachable by URL, but the content stays blurred until
 * the visitor has every achievement - a soft gate, by design. noindex so it never
 * shows up in search.
 */
const graph = buildGraph([
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Unlocked', path: '/unlocked' },
  ]),
]);

const mail = `mailto:${contact.email}?subject=${encodeURIComponent('I finished your site')}`;
---

<BaseLayout
  title={`Unlocked - ${site.shortName}`}
  description="A behind-the-scenes page for people who explored the whole site."
  graph={graph}
  noindex
>
  <div data-unlocked data-total={QUEST_TOTAL}>
    <header class="container-page pt-14 pb-10 sm:pt-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-warm">Unlocked</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Director's commentary
      </h1>
      <p class="mt-4 max-w-xl text-fg-soft" data-unlocked-intro>
        You found everything. Here is the part that does not go in a case study: what went
        wrong, what I would redo, and the whole log.
      </p>
    </header>

    <!-- Shown instead of the content when the visitor arrives early. -->
    <section data-unlocked-gate hidden class="container-page pb-16">
      <div class="max-w-xl rounded-2xl border border-line bg-surface/60 p-6 sm:p-8">
        <p class="font-mono text-xs text-muted">
          <span data-unlocked-remaining>{QUEST_TOTAL}</span> achievements left
        </p>
        <h2 class="mt-3 text-xl font-semibold tracking-tight">Not yet</h2>
        <p class="mt-3 text-sm text-fg-soft">
          This page opens once you have explored the whole site. The explorer badge in the bottom
          left lists what is still out there - locked ones show a hint.
        </p>
        <a
          href="/"
          class="mt-6 inline-block rounded-lg border border-line px-4 py-2 text-sm text-fg-soft transition-colors hover:border-accent hover:text-accent"
        >
          Back to the start
        </a>
      </div>
    </section>

    <div data-unlocked-content>
      <section aria-labelledby="commentary-heading" class="container-page pb-16">
        <h2 id="commentary-heading" class="sr-only">Behind each project</h2>
        <ul class="grid gap-6 sm:grid-cols-2">
          {
            projects.map((project) => (
              <li
                class="reveal rounded-xl border border-line bg-surface/60 p-6"
                style={`--project-accent: ${project.accent}`}
              >
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-muted">
                  {project.period}
                </p>
                <h3 class="mt-2 text-lg font-medium">
                  <a href={`/work/${project.slug}`} class="transition-colors hover:text-accent">
                    {project.name}
                  </a>
                </h3>
                <p class="mt-3 text-sm text-fg-soft text-pretty">{project.commentary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="log-heading" class="container-page pb-16">
        <h2 id="log-heading" class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
          git log --oneline --all
        </h2>
        <ol class="mt-6 overflow-hidden rounded-xl border border-line bg-surface font-mono text-[0.75rem] leading-relaxed">
          {
            milestones.map((entry) => (
              <li class="flex gap-3 border-b border-line px-4 py-2 last:border-b-0">
                <span class="text-warm">{entry.hash}</span>
                <span class="text-muted">{entry.date}</span>
                <span class="text-fg-soft">{entry.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="container-page pb-8">
        <div class="rounded-2xl border border-warm/40 bg-surface/60 p-6 text-center sm:p-12">
          <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            You read the whole thing. Most people do not.
          </h2>
          <p class="mx-auto mt-4 max-w-md text-fg-soft">
            Tell me you got here and I will reply with the same thoroughness.
          </p>
          <a
            href={mail}
            data-quest="ready-to-talk"
            class="mt-8 inline-block rounded-lg bg-warm px-6 py-3 font-medium text-bg transition-transform hover:-translate-y-0.5"
          >
            Say hello
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  [data-unlocked][data-locked] [data-unlocked-content] {
    filter: blur(8px);
    opacity: 0.35;
    pointer-events: none;
    user-select: none;
  }

  [data-unlocked][data-locked] [data-unlocked-intro] {
    display: none;
  }
</style>

<script>
  import { progress } from '../scripts/quests';

  function gate() {
    const root = document.querySelector<HTMLElement>('[data-unlocked]');
    if (!root) return;
    const { done, total } = progress();
    const locked = done < total;
    root.toggleAttribute('data-locked', locked);
    const gateEl = root.querySelector<HTMLElement>('[data-unlocked-gate]');
    if (gateEl) gateEl.hidden = !locked;
    const remaining = root.querySelector('[data-unlocked-remaining]');
    if (remaining) remaining.textContent = String(total - done);
    const content = root.querySelector<HTMLElement>('[data-unlocked-content]');
    if (content) content.setAttribute('aria-hidden', String(locked));
  }

  document.addEventListener('astro:page-load', gate);
  document.addEventListener('quest:unlock', gate);
  if (document.readyState !== 'loading') gate();
</script>
