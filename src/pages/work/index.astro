---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectCategories } from '../../data/projects';
import { buildGraph, breadcrumbNode, itemListNode, projectNode } from '../../lib/seo';

const graph = buildGraph([
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
  ]),
  itemListNode(),
  ...projects.map(projectNode),
]);

const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const filters = [
  { id: 'all', label: 'Everything', category: null },
  ...projectCategories.map((category) => ({
    id: slug(category),
    label: category,
    category,
  })),
];

/**
 * Filtering is done in CSS via `:has()` on the checked radio, so switching tabs
 * costs zero JavaScript and still works with the keyboard.
 */
const filterCss = filters
  .filter((filter) => filter.category)
  .map(
    (filter) =>
      `.work-index:has(#filter-${filter.id}:checked) [data-category]:not([data-category="${filter.category}"]){display:none}`,
  )
  .join('');
---

<BaseLayout
  title="Work — platforms, SaaS, and mobile apps by SM Saimul Islam"
  description="Case studies from SM Saimul Islam: Tathirmichil admissions platform, Flow business operations SaaS, the StuDays student discount app, and earlier mobile builds."
  graph={graph}
>
  <div class="work-index">
    <header class="container-page pt-14 pb-10 sm:pt-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Work</p>
      <h1 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Everything here shipped to real users
      </h1>
      <p class="mt-4 max-w-xl text-fg-soft">
        Four builds across web platforms, business SaaS, and mobile. Each one has a case study with
        the problem, the approach, and what it took to get it live.
      </p>

      <fieldset class="mt-8 flex flex-wrap gap-2">
        <legend class="sr-only">Filter work by type</legend>
        {
          filters.map((filter, index) => (
            // Each pair is wrapped so the `peer-checked:` sibling selector only
            // ever sees its own radio.
            <div>
              <input
                type="radio"
                name="work-filter"
                id={`filter-${filter.id}`}
                class="peer sr-only"
                checked={index === 0}
              />
              <label
                for={`filter-${filter.id}`}
                class="block cursor-pointer rounded-full border border-line px-4 py-1.5 text-sm text-fg-soft transition-colors hover:border-accent/60 peer-checked:border-accent peer-checked:bg-accent-soft/30 peer-checked:text-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-accent"
              >
                {filter.label}
              </label>
            </div>
          ))
        }
      </fieldset>
    </header>

    <div class="container-page grid gap-x-8 gap-y-14 pb-8 sm:grid-cols-2">
      {projects.map((project, index) => <ProjectCard project={project} eager={index === 0} />)}
    </div>
  </div>

  <style is:inline set:html={filterCss}></style>
</BaseLayout>
